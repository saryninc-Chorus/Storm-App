{
  "name": "sacred-inner-circle",
  "version": "1.0.0",
  "description": "A magical React component inspired by Android layouts for sacred UIs.",
  "keywords": ["sacred", "ui", "react", "android", "layout", "component"],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saryninc-Chorus/Storm-App.git"
  },
  "bugs": {
    "url": "https://github.com/saryninc-Chorus/Storm-App/issues"
  },
  "homepage": "https://github.com/saryninc-Chorus/Storm-App#readme",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "babel src --extensions \".js,.jsx,.ts,.tsx\" --env-name esm --out-dir dist --ignore \"**/*.test.*\"",
    "build:cjs": "babel src --extensions \".js,.jsx,.ts,.tsx\" --env-name cjs --out-file-extension .cjs --out-dir dist --ignore \"**/*.test.*\"",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17 || >=18",
    "react-dom": ">=17 || >=18"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "typescript": "^5.6.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0"
  },
  "engines": {
    "node": ">=16"
  }
}